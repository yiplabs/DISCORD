# ============================================
# Dollar Vibe Club Bot Environment Variables
# ============================================

# 1. Go to https://discord.com/developers/applications
# 2. Click "New Application" → name it "Dollar Vibe Club Bot"
# 3. Go to "Bot" tab → click "Reset Token" → copy it here
# 4. ENABLE ALL 3 PRIVILEGED INTENTS (Presence, Server Members, Message Content)
DISCORD_TOKEN=your_bot_token_here

# 5. Go to "OAuth2" tab → copy the "Client ID"
CLIENT_ID=1485242134746628166

# Your YouTube Channel ID (channel #1)
# HOW TO FIND IT:
#   1. Go to https://www.youtube.com/@TOMMYYIPXYZ
#   2. Right-click → View Page Source
#   3. Ctrl+F search for "channelId"
#   4. Copy the UC... string (24 characters starting with UC)
# OR go to youtube.com/account_advanced while logged in
YOUTUBE_CHANNEL_ID=your_UC_channel_id_here
# The @handle used in notification links/mentions for channel #1 (no @)
YOUTUBE_HANDLE=TOMMYYIPXYZ

# Second YouTube channel — HUNTER YIPLABS (https://www.youtube.com/@HUNTERYIPLABS)
# Notifications for this channel are posted in the SAME Discord channel as #1.
# These default to HUNTER YIPLABS, so you only need to set them to watch a
# different second channel.
YOUTUBE_CHANNEL_ID_2=UC_oMk6B6Hv7PwoyskeWWS2g
YOUTUBE_HANDLE_2=HUNTERYIPLABS

# ============================================
# Dollar Vibe Club website integration (shared XP)
# ============================================
# Base URL of the DVC web app that awards XP.
DVC_API_BASE=https://dollarvibeclub.com
# Shared secret for the XP endpoints. Must EXACTLY match DISCORD_BOT_XP_SECRET
# set on the DVC web server.
DISCORD_BOT_XP_SECRET=your_shared_secret_here
# Optional: the "Link Discord" page URL. If set, /rank and the once-per-day
# unlinked reminder point members here. Leave blank to disable the reminder.
DVC_LINK_URL=
