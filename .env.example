# Dollar Vibe Club Discord bot
#
# Keep secrets in Railway Variables. Never commit a real bot token or the
# server-to-server XP secret.

# Required Discord application credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Pin the bot to the Dollar Vibe Club server and its announcement channel.
# These make the configuration survive Railway restarts and redeploys.
DISCORD_GUILD_ID=your_dvc_guild_id_here
DISCORD_NOTIFY_CHANNEL_ID=your_announcements_channel_id_here

# Existing Dollar Vibe Club account + XP bridge
DVC_API_URL=https://dollarvibeclub.com
DVC_WEB_URL=https://dollarvibeclub.com
DISCORD_BOT_XP_SECRET=your_shared_server_to_server_secret_here

# Verified creator channels
YOUTUBE_CHANNEL_ID=UCvNg5BdvvvU3-1RL5mRi6lQ
YOUTUBE_HANDLE=TOMMYYIPXYZ
YOUTUBE_CHANNEL_ID_2=UC_oMk6B6Hv7PwoyskeWWS2g
YOUTUBE_HANDLE_2=HUNTERYIPLABS

# Optional opt-in notification role. Leave blank for no mass mention.
YOUTUBE_MENTION_ROLE_ID=
# Optional comma-separated channel IDs whose live events ping @everyone.
# DVC production includes both verified creator channels; uploads remain quiet.
YOUTUBE_LIVE_PING_EVERYONE_CHANNEL_IDS=
# Emergency legacy behavior only. Keep false in production.
YOUTUBE_PING_EVERYONE=false
